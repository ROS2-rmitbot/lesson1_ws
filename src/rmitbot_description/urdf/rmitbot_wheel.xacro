<?xml version="1.0"?>
<robot name="rmitbot" xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:gz="http://gazebosim.org/schema">

  <xacro:macro name="rmit_wheel" params="prefix x_reflect y_reflect fdir">

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 ${y_reflect*0.025}" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.05" length="0.05" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0 0 ${y_reflect*0.025}" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.05" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${y_reflect*0.025}" rpy="0 0 0" />
        <mass value="0.5" />
        <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0020" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="${x_reflect*0.14} ${y_reflect*0.15} 0" rpy="-${pi/2} 0 0" />
      <parent link="base_link" />
      <child link="${prefix}_wheel" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.2" />
    </joint>

    <gazebo reference="${prefix}_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_footprint">${fdir}</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

  </xacro:macro>

  <xacro:rmit_wheel prefix="front_left" x_reflect="1" y_reflect="1" fdir="1 -1 0" />
  <xacro:rmit_wheel prefix="front_right" x_reflect="1" y_reflect="-1" fdir="1 1 0" />
  <xacro:rmit_wheel prefix="rear_left" x_reflect="-1" y_reflect="1" fdir="1 1 0" />
  <xacro:rmit_wheel prefix="rear_right" x_reflect="-1" y_reflect="-1" fdir="1 -1 0" />

</robot>