<?xml version="1.0"?>
<robot name="rmitbot" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <link name="base_footprint" />
  
  <!-- Inertial, visual, collision of the link -->
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
         <box size=".28 .3 0.1" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
         <box size=".28 .3 0.1" />
      </geometry>
      <material name="orange" />
    </visual>
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia
        ixx="0.13"
        ixy="0.0"
        ixz="0.0"
        iyy="0.42"
        iyz="0.0"
        izz="0.48" />
    </inertial>
  </link>

  <!-- Parent, child, and origin -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

</robot>